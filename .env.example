# ============================================================
# Frontend EncoderGoti — Variables de Entorno
# Copiar este archivo como .env y completar los valores.
# NUNCA commitear el archivo .env (ya esta en .gitignore).
# El prefijo EXPO_PUBLIC_ es obligatorio para que Expo
# inyecte las variables en el bundle del cliente.
# ============================================================

# SUPABASE — Credenciales del proyecto
EXPO_PUBLIC_SUPABASE_URL=https://kxzonorzqvvtakioaypo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima_aqui

# BACKEND — URL del servidor Express segun entorno:
# Android Emulator:           http://10.0.2.2:3000/api
# Dispositivo fisico Expo Go: http://TU_IP_LOCAL:3000/api  (ej: 192.168.1.2)
# Web / iOS Simulator:        http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://192.168.1.2:3000/api
